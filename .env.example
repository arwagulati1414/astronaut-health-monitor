# Google Gemini. Either variable is enough. Leave both blank to use the offline rule engine.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
# gemini-2.5-flash is rejected for new keys. Keep a model your key can call.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Leave blank to run the in-browser demo. Never expose the service role to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
